{
  "repo": "ChinmayGopal931/vizor-fork",
  "workflows": {
    "linux": ".github/workflows/veylor-linux.yml",
    "android": ".github/workflows/veylor-android.yml",
    "windows": ".github/workflows/veylor-windows.yml"
  },
  "android_certificate_sha256": "83f16e2037b09e731e51b3472466db43c4a962ada1fb4e40eaa4c3215a2174f5",
  "summaries": {
    "veylor-android/v1.0.3": "Now also a direct download, built by GitHub and signed by Veylor.",
    "veylor-linux/v0.9.1": "Built and published by GitHub, with a signed record of every file's build.",
    "veylor-linux/v0.9.0": "The first Linux release."
  },
  "platforms": [
    {
      "id": "android",
      "name": "Android",
      "icon": "Android",
      "group": "main",
      "release": "android",
      "status": "Available",
      "requirements": "Android 11+",
      "store": {
        "label": "Google Play",
        "href": "https://play.google.com/store/apps/details?id=com.veylor.app"
      },
      "download": {
        "match": "^veylor-[0-9.]+-[0-9]+\\.apk$",
        "label": "Download APK"
      },
      "without_release": "Direct APK coming soon.",
      "headline": "On Google Play"
    },
    {
      "id": "linux",
      "name": "Linux",
      "icon": "Linux",
      "group": "main",
      "release": "linux",
      "status": "Beta",
      "requirements": "x86_64 and ARM · Ubuntu 22.04+, Debian 12+",
      "download": {
        "match": "^veylor_[0-9.]+_amd64\\.deb$",
        "label": "Download .deb"
      }
    },
    {
      "id": "iphone",
      "name": "iPhone",
      "icon": "iPhone",
      "group": "more",
      "status": "Beta",
      "headline": "TestFlight beta",
      "store": {
        "label": "Join the beta",
        "href": "https://testflight.apple.com/join/D9gw2Kwm"
      }
    },
    {
      "id": "mac",
      "name": "Mac",
      "icon": "Mac",
      "group": "more",
      "release": "macos",
      "status": "Coming soon",
      "requirements": "macOS 12+ · signed and notarized",
      "headline": "Waiting on Apple"
    },
    {
      "id": "windows",
      "name": "Windows",
      "icon": "Windows",
      "group": "more",
      "release": "windows",
      "status": "Coming soon",
      "requirements": "x64 and ARM",
      "headline": "In testing"
    }
  ],
  "files": [
    {
      "match": "^veylor-[0-9.]+-[0-9]+\\.apk$",
      "label": "Install this one",
      "signed_from": "-unsigned.apk"
    },
    {
      "match": "-unsigned\\.apk$",
      "label": "The attested build, unsigned · for checking"
    },
    {
      "match": "^veylor_[0-9.]+_amd64\\.deb$",
      "label": "Ubuntu, Debian · x86_64"
    },
    {
      "match": "^veylor_[0-9.]+_arm64\\.deb$",
      "label": "Ubuntu, Debian · ARM"
    },
    {
      "match": "^Veylor-linux-x86_64\\.AppImage$",
      "label": "Other distributions · x86_64"
    },
    {
      "match": "^Veylor-linux-aarch64\\.AppImage$",
      "label": "Other distributions · ARM"
    },
    {
      "match": "^SHA256SUMS$",
      "label": "Every SHA-256 above"
    }
  ]
}
